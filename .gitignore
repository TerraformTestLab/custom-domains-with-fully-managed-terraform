# Local .terraform directories
**/.terraform/*
.terraform/
.idea
.mcp.json

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable files (may contain secrets / environment-specific values)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Plan output files
*.tfplan
*.tfplan.*

# CLI config / override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
